# =========================================================================
# Adaptive Lighting System — Environment Configuration Template
# Placeholders only. Do NOT commit production secrets.
# =========================================================================

# Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe for browser client with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Device Shared Secret Token (used by ESP32 in x-device-token header)
DEVICE_API_TOKEN=esp32_super_secret_token_123

# Edge Function Service Role Key (ONLY used in Supabase Edge Function environment)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose-in-frontend
